# ── Database ────────────────────────────────────────────────
# Postgres connection string. Local example:
#   DATABASE_URL=postgres://postgres:password@localhost:5432/substore
# Managed Postgres (Neon / Render / RDS) pe PGSSL=true bhi chahiye hota hai.
DATABASE_URL=postgres://postgres:password@localhost:5432/substore
PGSSL=false

# ── Auth ────────────────────────────────────────────────────
# Lamba random string. Aise banayein:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Server ──────────────────────────────────────────────────
PORT=3001

# ── Frontend ────────────────────────────────────────────────
# Dev mein khaali chhod dein — Vite /api ko proxy kar deta hai.
# Production mein API ka poora URL daalein, jaise https://api.substore.in
VITE_API_URL=
