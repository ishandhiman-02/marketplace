# Supabase project ki settings > API se copy karein.
# Is file ko .env naam se copy karke values bharein — .env git mein nahi jaati.
#
#   cp .env.example .env

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: anon key public hai — browser mein jaati hai. Data ki suraksha
# Row Level Security policies se hoti hai (supabase/schema.sql dekhein),
# key chhupane se nahi. service_role key kabhi yahan mat daalein.
