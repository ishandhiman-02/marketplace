# ── Database ────────────────────────────────────────────────
# Postgres connection string. Local example:
#   DATABASE_URL=postgres://postgres:password@localhost:5432/substore
# Managed Postgres (Neon / Render / RDS) usually needs PGSSL=true as well.
DATABASE_URL=postgres://postgres:password@localhost:5432/substore
PGSSL=false

# ── Auth ────────────────────────────────────────────────────
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Server ──────────────────────────────────────────────────
PORT=3001

# ── Frontend ────────────────────────────────────────────────
# Leave empty in dev — Vite proxies /api for you.
# In production put the full API URL here, e.g. https://api.substore.in
VITE_API_URL=
