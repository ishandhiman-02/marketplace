# Local backend config. Copy to backend/.env — that file is git-ignored and
# .dockerignore'd, so it never reaches a commit or an image.
#
# These are exactly the variables the deploy provides. Read everything from
# here; never hardcode a connection string or a schema.

# ── Database ────────────────────────────────────────────────
# All projects share one database and are separated by schema.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=substore
DB_SCHEMA=substore_dev

# ── Auth ────────────────────────────────────────────────────
# A long random string. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=

# ── Server ──────────────────────────────────────────────────
PORT=8080
ENV=development

# ── First admin (optional) ──────────────────────────────────
# Only used while admin_users is empty. Leave both unset and the migration
# generates a password and prints it once to the log.
# ADMIN_EMAIL=admin@substore.local
# ADMIN_PASSWORD=
